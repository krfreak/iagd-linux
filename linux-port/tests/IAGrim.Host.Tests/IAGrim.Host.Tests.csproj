<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IAGrim.Host.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Two kinds of thing live here.

    The transfer path, which is the one place in this port where a mistake creates items out of
    nothing. Everything for it runs against a throwaway prefix root and a throwaway database, so
    the deletion rule can be exercised without touching a real collection.

    And the decisions behind individual routes. ApiRouter dispatches on a real
    HttpListenerContext, which nothing outside HttpListener can construct, so the router itself is
    not what these test; the judgements are pulled out of its switch as plain static logic —
    whether a pair of stash tabs is safe to save together (StashTabGuard), which names
    /api/open-folder will resolve (KnownFolders) — and checked without a server or a listener.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/IAGrim.Host/IAGrim.Host.csproj" />
    <ProjectReference Include="../../src/IAGrim.Platform/IAGrim.Platform.csproj" />
  </ItemGroup>

</Project>
