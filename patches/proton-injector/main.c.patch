+/* Newest matching process wins: if the game was restarted, the stale entry may still be
+   winding down, and injecting into a dying process silently does nothing. */
+static DWORD find_process_by_name(const wchar_t *name) {
+    HANDLE snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
+    if (snapshot == INVALID_HANDLE_VALUE)
+        return 0;
+
+    PROCESSENTRY32W pe = {0};
+    pe.dwSize = sizeof(pe);
+
+    DWORD    best_pid = 0;
+    FILETIME best_start = {0};
+
+    if (Process32FirstW(snapshot, &pe)) {
+        do {
+            if (_wcsicmp(pe.szExeFile, name) != 0)
+                continue;
+
+            HANDLE proc = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pe.th32ProcessID);
+            if (!proc)
+                continue;
+
+            FILETIME start, exit_t, kernel_t, user_t;
+            if (GetProcessTimes(proc, &start, &exit_t, &kernel_t, &user_t)) {
+                if (!best_pid || CompareFileTime(&start, &best_start) > 0) {
+                    best_pid   = pe.th32ProcessID;
+                    best_start = start;
+                }
+            } else if (!best_pid) {
+                best_pid = pe.th32ProcessID;
+            }
+            CloseHandle(proc);
+        } while (Process32NextW(snapshot, &pe));
+    }
+
+    CloseHandle(snapshot);
+    return best_pid;
+}
+
+static DWORD wait_for_process_by_name(const wchar_t *name, DWORD timeout_ms) {
+    const DWORD interval = 1000;
+    DWORD waited = 0;
+
+    LOG_INFO(L"Waiting for a running process named '%ls'...", name);
+
+    for (;;) {
+        DWORD pid = find_process_by_name(name);
+        if (pid) {
+            LOG_INFO(L"Found '%ls' (PID: %lu)", name, pid);
+            return pid;
+        }
+        if (timeout_ms && waited >= timeout_ms) {
+            LOG_ERROR(L"Timed out after %lu ms waiting for '%ls'", timeout_ms, name);
+            return 0;
+        }
+        Sleep(interval);
+        waited += interval;
+    }
+}
+
+/* A failed injection is not necessarily fatal: a DLL may refuse the attach because the
+   host is not ready yet (still loading, wrong game state) and unload itself, which is
+   indistinguishable here from a hard failure. Retrying is what makes that recoverable. */
+static int attach_and_inject(const Arguments *args, wchar_t **dll_paths_full) {
+    DWORD pid = wait_for_process_by_name(args->attach_name, args->attach_timeout_ms);
+    if (!pid)
+        return 1;
+
+    if (args->sleep_ms > 0) {
+        LOG_INFO(L"Sleeping for %lu ms before injection...", args->sleep_ms);
+        Sleep(args->sleep_ms);
+    }
+
+    for (int attempt = 1;; attempt++) {
+        HANDLE proc = OpenProcess(PROCESS_ALL_ACCESS, FALSE, pid);
+        if (!proc) {
+            LOG_ERROR(L"Failed to open process %lu: error %lu", pid, GetLastError());
+            return 1;
+        }
+
+        DWORD exit_code = 0;
+        if (GetExitCodeProcess(proc, &exit_code) && exit_code != STILL_ACTIVE) {
+            LOG_WARN(L"Process %lu has exited; looking for a new one", pid);
+            CloseHandle(proc);
+            pid = wait_for_process_by_name(args->attach_name, args->attach_timeout_ms);
+            if (!pid)
+                return 1;
+            continue;
+        }
+
+        wait_for_process_init(proc, 10000);
+
+        HANDLE thread = NULL;
+        InjectionMethod method = args->method;
+        if (method == INJECTION_APC) {
+            DWORD tid = find_process_main_thread(pid);
+            if (tid)
+                thread = OpenThread(THREAD_SUSPEND_RESUME | THREAD_SET_CONTEXT | THREAD_GET_CONTEXT,
+                                    FALSE, tid);
+            if (!thread) {
+                LOG_WARN(L"Could not open main thread; falling back to standard injection");
+                method = INJECTION_STANDARD;
+            }
+        }
+
+        BOOL suspended = FALSE;
+        if (method == INJECTION_APC && SuspendThread(thread) != (DWORD)-1)
+            suspended = TRUE;
+
+        BOOL all_ok = TRUE;
+        for (int i = 0; i < args->dll_count; i++) {
+            LOG_INFO(L"Injecting DLL %d/%d into PID %lu (attempt %d)...",
+                     i + 1, args->dll_count, pid, attempt);
+            if (!inject_dll(proc, thread, pid, dll_paths_full[i], method)) {
+                LOG_ERROR(L"Injection failed: %ls", dll_paths_full[i]);
+                all_ok = FALSE;
+                break;
+            }
+            LOG_INFO(L"DLL injected successfully: %ls", dll_paths_full[i]);
+        }
+
+        if (suspended)
+            ResumeThread(thread);
+        if (thread)
+            CloseHandle(thread);
+        CloseHandle(proc);
+
+        if (all_ok) {
+            LOG_INFO(L"Injection complete after %d attempt(s)", attempt);
+            return 0;
+        }
+
+        if (args->attach_retry_ms == 0) {
+            LOG_ERROR(L"Injection failed and retrying is disabled");
+            return 1;
+        }
+
+        LOG_INFO(L"Retrying in %lu ms. If the target rejects the attach while loading, "
+                 L"this is expected until it reaches a ready state.", args->attach_retry_ms);
+        Sleep(args->attach_retry_ms);
+    }
+}
