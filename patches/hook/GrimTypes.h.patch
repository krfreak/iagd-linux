+// PORT FIX: lazy export binding.
+//
+// These were `static auto fnX = pX(GetProcAddressOrLogToFile(...))` at header scope, so
+// every translation unit resolved them during static initialisation -- before DllMain, and
+// before game.dll is necessarily loaded. On failure GetProcAddressOrLogToFile logs through
+// g_log, which may not be constructed yet (different translation unit, unspecified order).
+// That is undefined behaviour occurring before any log file exists.
+//
+// LazyExport defers the lookup to first use. The implicit conversion to the function
+// pointer type means call sites keep working verbatim: `fnX(args)` and `if (fnX)` both
+// behave exactly as before.
+// Thread safety matters here in a way it did not upstream. Upstream resolved these during
+// static initialisation, before any thread existed. Deferring to first use means several
+// threads (the game's render thread, the DLL's worker thread, the seed-info thread) can
+// reach the same accessor simultaneously -- which they do the first time the stash opens.
+//
+// A naive "if (!resolved) { resolved = true; fn = ...; }" publishes the flag before the
+// value, so a second thread can observe resolved == true while fn is still null and call
+// through a null pointer. That crashes the game.
+//
+// A single atomic with a sentinel avoids the ordering problem entirely: a thread either
+// sees UNRESOLVED and does the lookup, or sees a fully-written pointer. Two threads racing
+// may both resolve, which is harmless -- GetProcAddress is idempotent.
+template <class Fn>
+class LazyExport {
+public:
+	LazyExport(const wchar_t* dll, const char* name) : m_dll(dll), m_name(name) {}
+
+	Fn get() const {
+		void* cached = m_fn.load(std::memory_order_acquire);
+		if (cached == Unresolved()) {
+			cached = reinterpret_cast<void*>(GetProcAddressOrLogToFile(m_dll, const_cast<char*>(m_name)));
+			m_fn.store(cached, std::memory_order_release);
+		}
+		return reinterpret_cast<Fn>(cached);
+	}
+
+	operator Fn() const { return get(); }
+
+private:
+	// Distinct from nullptr, which is a legitimate "export is missing" result.
+	static void* Unresolved() { return reinterpret_cast<void*>(static_cast<intptr_t>(-1)); }
+
+	const wchar_t* m_dll;
+	const char* m_name;
+	mutable std::atomic<void*> m_fn{ reinterpret_cast<void*>(static_cast<intptr_t>(-1)) };
+};
+
+static LazyExport<pCreateItem> fnCreateItem(L"game.dll", "?CreateItem@Item@GAME@@SAPEAV12@AEBUItemReplicaInfo@2@@Z");
 
