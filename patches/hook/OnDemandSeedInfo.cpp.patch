+/// Trims a replica string that WE built (assign_owned from a CSV token).
+///
+/// Never call this on a replica the game filled in: those buffers belong to the game's
+/// allocator, and free_owned() would hand one to the wrong allocator.
+static void TrimOwned(MsvcInterop::String& s) {
+	std::string tmp(s.c_str(), s.length());
+	boost::algorithm::trim(tmp);
+	if (tmp.size() != s.length()) {
+		s.free_owned();
+		s = tmp;
+	}
+}
