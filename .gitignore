# Generated third-party trees. Upstream's sources are pinned as submodules and patched into
# these directories by scripts/prepare.sh — see THIRD-PARTY.md for why they are not committed.
/build/
/linux-port/native/hook/generated/

# Build output
bin/
obj/
node_modules/
# `dotnet test --logger trx` writes here.
TestResults/
/linux-port/native/hook/build/
/linux-port/packaging/out/
# Everything vite writes: the hashed bundles, the index that names them, and whatever it
# copies out of public/ — which now includes the images from upstream's help page.
/linux-port/src/IAGrim.Host/wwwroot/
# The application icon and its panel sizes, extracted from upstream's gd.ico at build
# time by packaging/make-icon.sh — or drawn, without the submodule.
/linux-port/src/IAGrim.App/assets/iagd.png
/linux-port/src/IAGrim.App/assets/iagd-*.png

# Collections, logs and other run-time state. A database here would be someone's real
# collection, complete with the cloud credentials upstream keeps in its settings.
*.db
*.db-wal
*.db-shm
*.log

# Local Claude Code permissions, which are this machine's rather than the project's.
/.claude/settings.local.json

# Diagnostic tools are single .c files compiled on demand; the binaries are outputs.
/linux-port/tools/*/*.dll
/linux-port/tools/*/*.exe

# Throwaway probe projects the verify scripts build to read the port's own tables back.
/linux-port/scripts/.*-probe/

# Build output of the committed search-filter probe.
/linux-port/scripts/search-probe/bin/
/linux-port/scripts/search-probe/obj/

# Upstream's help page, read out of the pinned submodule at build time by
# linux-port/scripts/extract-help.py. Generated for the same reason the hook and the injector
# are: this repository carries the porting work, not somebody else's content.
/linux-port/src/WebUI/src/generated/
/linux-port/src/WebUI/public/help/
/linux-port/src/WebUI/public/favicon.png
